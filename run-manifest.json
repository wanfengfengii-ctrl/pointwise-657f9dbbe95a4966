    "import_sample": ["python3.11", "-B", "-m", "delivery.app", "import", "--db", "quality.sqlite", "examples/day.json"],
    "verify": ["python3.11", "-B", "-m", "unittest", "discover", "-s", "tests", "-t", ".", "-v"],
